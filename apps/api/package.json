    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "express-rate-limit": "^7.4.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.7.2",
    "node-cache": "^5.1.2",
    "openai": "^4.52.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/bcrypt": "^5.0.2",
